NODE_ENV=development
PORT=5000

# Database — replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/ai-os

# Frontend origin (no trailing slash)
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────
# JWT Secrets — generate strong unique values for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET and JWT_REFRESH_SECRET MUST be different from each other.
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_64char_random_hex_string_for_production
JWT_REFRESH_SECRET=replace_with_a_different_strong_64char_random_hex_string_for_production
JWT_EXPIRES_IN=15m

# ─────────────────────────────────────────────────────────────────
# AI Provider API Keys (server-side only — never expose in frontend)
# ─────────────────────────────────────────────────────────────────

# Google Gemini (required when DEFAULT_CHAT_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# OpenAI (optional — only required for image generation features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=dall-e-3

# ─────────────────────────────────────────────────────────────────
# Provider routing configuration
# ─────────────────────────────────────────────────────────────────
DEFAULT_CHAT_PROVIDER=gemini
DEFAULT_ANALYSIS_PROVIDER=gemini
DEFAULT_IMAGE_PROVIDER=openai
DEFAULT_IMAGE_EDIT_PROVIDER=openai
ENABLE_PROVIDER_ROUTER=true
