NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-os
CLIENT_URL=http://localhost:3000
JWT_SECRET=super_secret_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=1d

# Hybrid AI Provider configurations
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_ANALYSIS_MODEL=gemini-flash-lite-latest

# Optional/Deferred OpenAI configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
